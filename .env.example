# ============================================================
# AeroAdmin AFM — variables de entorno (ejemplo)
# Copiar a `.env.local` y completar. NUNCA commitear el .env real.
# La validación de arranque vive en `lib/env.ts` (reporta faltantes).
# ============================================================

# ---------- Base de datos (Postgres + PostGIS) ----------
# Local (docker): `npm run db:up` levanta el compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afm_flights
# Prod Supabase: usar la POOLED url (puerto 6543), no la directa (5432 = IPv6).
DATABASE_URL_DIRECT=
DATABASE_SSL=false
# Forzar comportamiento estricto de withLocalFallback (true/false).
# Default: true en producción con DB. "false" lo desactiva (debug).
DATABASE_STRICT=
SUPABASE_PROJECT_REF=

# ---------- Auth (NextAuth v5) ----------
# Generate con: openssl rand -base64 32
AUTH_SECRET=change-me-in-production
# URL pública del panel (prod). En dev se infiere. Alias: NEXTAUTH_URL.
AUTH_URL=
AUTH_SEED_EMAIL=admin@aeroadmin.local
AUTH_SEED_PASSWORD=ChangeMe123!
AUTH_SEED_ROLE=admin

# ---------- Marca / operador (headers de reportes PDF/CSV) ----------
OPERATOR_NAME=AeroAdmin Cañero
OPERATOR_REGION=Valle del Cauca, Colombia
NEXT_PUBLIC_OPERATOR_NAME=AeroAdmin Cañero
NEXT_PUBLIC_OPERATOR_REGION=Valle del Cauca, Colombia

# ---------- Geovisor ----------
# Si está vacío, el geovisor cae a EOX Sentinel-2 cloudless (10m).
NEXT_PUBLIC_MAPTILER_KEY=

# ---------- Tokens internos (bypass de sesión para CLI/cron/internos) ----------
# Health del pipeline DJI (watchdog). Bearer token para /api/admin/djiag-health.
HEALTH_TOKEN=
HEALTH_URL=
HEALTH_STALE_HOURS=24
# Refresh de fumigaciones por cron.
BACKFILL_TOKEN=
BACKFILL_URL=
# Gate del endpoint interno de mapas de PDF (si vacío, queda sin gate en dev).
INTERNAL_MAP_TOKEN=

# ---------- Alertas operacionales (watchdog) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------- Scraper DJI SmartFarm (scripts CLI) ----------
DJIAG_EMAIL=
DJIAG_PASSWORD=
DJIAG_DAYS_BACK=30
DEBUG_DJIAG=
DEBUG_PIPELINE=

# ---------- Backups ----------
BACKUP_RETENTION_DAYS=7
